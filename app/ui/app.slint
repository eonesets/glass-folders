// Кратко: интерфейс — окно открытой папки (Panel) и плитка папки на столе (Tile).
// Geometry is computed in Rust (model.rs); this file only draws.


export struct SlotData {
    name: string,
    icon: image,
    id: int,
    k: int, // index in group (place = k, shifted live while dragging)
}

export struct GroupData {
    name: string,
    tint: color,
    colored: bool,
    fixed: bool, // "Разное" = folder root, cannot be renamed
    idx: int,
    x: length,
    y: length,
    w: length,
    h: length,
    cols: int, // size in slots
    rows: int,
    n: int, // item count (all items are in `items`; overflow shown as "+N")
    open: bool, // unfolded by a click on "+N": all items + a "fold" slot at the end
    items: [SlotData],
}

component Dot inherits Rectangle {
    in property <color> c;
    in property <bool> empty; // no color: hollow ring
    in property <bool> dark;
    in property <length> size: 14px;
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    background: empty ? transparent : c;
    border-width: ta.has-hover ? 2px : (empty ? 1.5px : 1px);
    border-color: ta.has-hover ? (dark ? #ffffffd0 : #000000a0) : empty ? (dark ? #ffffff80 : #00000060) : #00000030;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Caption button (Windows style): icon glyph from Segoe Fluent Icons.
component CapButton inherits Rectangle {
    in property <string> glyph;
    in property <length> glyph-size: 10px;
    in property <bool> danger; // red hover = close
    in property <bool> dark;
    in property <color> glyph-color: dark ? #ffffff : #1b1b1b;
    callback clicked;
    width: 46px;
    height: 36px;
    background: ta.pressed ? (danger ? #c42b1ce0 : (dark ? #ffffff10 : #0000000a)) : ta.has-hover ? (danger ? #c42b1c : (dark ? #ffffff18 : #0000000f)) : transparent;
    animate background { duration: 90ms; }
    Text {
        text: glyph;
        font-family: "Segoe Fluent Icons";
        font-size: glyph-size;
        color: (danger && ta.has-hover) ? #ffffff : glyph-color;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ---------- settings controls (Win11-like, quiet) ----------

// On/off switch.
component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> dark;
    in property <color> accent;
    callback toggled;
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: on ? (ta.pressed ? accent.darker(0.15) : accent) : (ta.has-hover ? (dark ? #ffffff10 : #00000008) : transparent);
    border-width: on ? 0px : 1px;
    border-color: dark ? #ffffff9c : #0000007a;
    animate background { duration: 120ms; }
    Rectangle {
        property <length> d: ta.pressed ? 14px : (ta.has-hover ? 13px : 12px);
        x: on ? parent.width - self.d - 4px : 4px;
        y: (parent.height - self.d) / 2;
        width: d;
        height: d;
        border-radius: d / 2;
        background: on ? (dark ? #000000 : #ffffff) : (dark ? #ffffffcc : #000000a6);
        animate x { duration: 160ms; easing: ease-out; }
        animate width, height, y { duration: 100ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Segmented choice: sliding thumb under the picked item.
component Seg inherits Rectangle {
    in property <[string]> items;
    in property <int> sel;
    in property <bool> dark;
    in property <length> seg-w: 58px;
    callback pick(int);
    width: items.length * seg-w + 4px;
    height: 28px;
    border-radius: 6px;
    background: dark ? #ffffff0c : #0000000a;
    Rectangle {
        x: 2px + sel * seg-w;
        y: 2px;
        width: seg-w;
        height: parent.height - 4px;
        border-radius: 4px;
        background: dark ? #ffffff1f : #ffffff;
        border-width: 1px;
        border-color: dark ? #ffffff10 : #0000000f;
        drop-shadow-blur: dark ? 0px : 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #0000001a;
        animate x { duration: 180ms; easing: ease-out; }
    }
    for t[i] in items: Rectangle {
        x: 2px + i * seg-w;
        y: 2px;
        width: seg-w;
        height: parent.height - 4px;
        Text {
            text: t;
            font-size: 12px;
            font-weight: sel == i ? 600 : 400;
            color: sel == i ? (dark ? #ffffff : #1b1b1b) : (st.has-hover ? (dark ? #ffffffd8 : #1b1b1bd8) : (dark ? #ffffff99 : #1b1b1b99));
        }
        st := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(i); }
        }
    }
}

// Group of rows on a quiet card. Rows: 44px (or 52px with a hint), hairline between them.
component Card inherits Rectangle {
    in property <bool> dark;
    border-radius: 8px;
    background: dark ? #ffffff0b : #ffffff9e;
    border-width: 1px;
    border-color: dark ? #ffffff0f : #0000000d;
}

component RowText inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> dark;
    Text {
        x: 14px;
        y: hint == "" ? (parent.height - 18px) / 2 : 9px;
        height: 18px;
        text: label;
        font-size: 13px;
        color: dark ? #ffffff : #1b1b1b;
        vertical-alignment: center;
    }
    if hint != "": Text {
        x: 14px;
        y: 27px;
        height: 15px;
        text: hint;
        font-size: 11px;
        color: dark ? #ffffff8a : #1b1b1b8a;
        vertical-alignment: center;
    }
}

component Hairline inherits Rectangle {
    in property <bool> dark;
    height: 1px;
    background: dark ? #0000004d : #0000000d;
}

// Card row: label (+ hint) and a switch on the right; `line` = hairline above it.
component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> on;
    in property <bool> line;
    in property <bool> dark;
    in property <color> accent;
    callback toggled;
    if line: Hairline {
        x: 14px;
        y: 0;
        width: parent.width - 28px;
        dark: root.dark;
    }
    RowText {
        x: 0;
        y: 0;
        width: parent.width - 64px;
        height: parent.height;
        label: root.label;
        hint: root.hint;
        dark: root.dark;
    }
    Switch {
        x: parent.width - 54px;
        y: (parent.height - self.height) / 2;
        on: root.on;
        dark: root.dark;
        accent: root.accent;
        toggled => { root.toggled(); }
    }
}

component SectionTitle inherits Text {
    in property <bool> dark;
    height: 20px;
    font-size: 12px;
    font-weight: 600;
    color: dark ? #ffffffb8 : #1b1b1bb8;
    vertical-alignment: center;
}

// Press + move > 5px = drag (pos in slot coords); else release = click. "+N" slot never drags.
component Slot inherits Rectangle {
    in property <SlotData> d;
    in property <bool> labels;
    in property <bool> dark;
    in property <float> lifted: 1; // opacity: dragged item = faint placeholder / hidden
    in property <bool> en; // English UI
    in property <int> more; // > 0: this slot shows "+N" instead of its icon; < 0: "fold back" slot
    callback clicked;
    callback drag-move(length, length);
    callback drag-end(length, length);
    callback drag-cancel();
    callback hover(bool); // pointer rests on it (not pressed, not dragged): name hint
    callback menu(); // right click: shortcut menu (Rust, native popup)
    property <bool> dragging;
    property <bool> hovered: ta.has-hover && !ta.pressed && !dragging && more == 0;
    changed hovered => { root.hover(hovered); }
    width: 76px;
    height: 76px;
    border-radius: 6px;
    opacity: lifted;
    animate opacity { duration: 120ms; }
    background: dragging ? transparent : ta.pressed ? (dark ? #ffffff24 : #00000018) : ta.has-hover ? (dark ? #ffffff14 : #0000000c) : transparent;
    animate background { duration: 100ms; }

    if more == 0: Image {
        source: d.icon;
        width: 48px;
        height: 48px;
        x: 14px;
        y: labels ? 6px : 14px;
    }
    if more != 0: Rectangle {
        width: 48px;
        height: 48px;
        x: 14px;
        y: labels ? 6px : 14px;
        border-radius: 10px;
        background: dark ? #ffffff1a : #0000000f;
        Text {
            text: more > 0 ? "+" + more : "\u{E70E}"; // chevron up = fold
            font-family: more > 0 ? "" : "Segoe Fluent Icons";
            font-size: more > 0 ? 16px : 14px;
            font-weight: 600;
            color: dark ? #ffffff : #1b1b1b;
        }
    }
    Text {
        visible: labels;
        text: more > 0 ? (en ? "more" : "ещё") : more < 0 ? (en ? "fold" : "свернуть") : d.name;
        x: 3px;
        y: 57px;
        width: parent.width - 6px;
        height: 16px;
        font-size: 11px;
        color: dark ? #ffffffe0 : #1b1b1be0;
        horizontal-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        moved => {
            if (!dragging && more == 0 && d.id >= 0
                && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px)) {
                dragging = true;
            }
            if (dragging) {
                root.drag-move(self.mouse-x, self.mouse-y);
            }
        }
        // clicked comes before the Up event -> dragging still set, no launch after a drag
        clicked => {
            if (!dragging) {
                root.clicked();
            }
        }
        pointer-event(e) => {
            if (!dragging && more == 0 && d.id >= 0 && e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.menu();
            }
            if (dragging && e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                dragging = false;
                root.drag-end(self.mouse-x, self.mouse-y);
            } else if (dragging && e.kind == PointerEventKind.cancel) {
                dragging = false;
                root.drag-cancel();
            }
        }
    }
}

// Drag handle of a group plate (edge strip): press + move > 5px = move the group.
// Points are in plate coords.
component Grip inherits TouchArea {
    callback lifted();
    callback go(length, length);
    callback done(length, length);
    callback cancel();
    property <bool> moving;
    mouse-cursor: move;
    moved => {
        if (!moving && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px)) {
            moving = true;
            root.lifted();
        }
        if (moving) {
            root.go(self.x + self.mouse-x, self.y + self.mouse-y);
        }
    }
    pointer-event(e) => {
        if (moving && e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
            moving = false;
            root.done(self.x + self.mouse-x, self.y + self.mouse-y);
        } else if (moving && e.kind == PointerEventKind.cancel) {
            moving = false;
            root.cancel();
        }
    }
}

export component Panel inherits Window {
    no-frame: true;
    background: transparent;
    title: "Glass Folders";

    in property <string> folder-name;
    in property <color> folder-tint;
    in property <bool> folder-colored;
    in property <[GroupData]> groups;
    in property <length> grid-w: 300px;
    in property <length> grid-h: 200px;
    in property <[color]> pal;
    in property <bool> dark; // set from Rust (Windows app theme)
    // settings (from Rust, saved in settings.json)
    in property <bool> labels: true;
    in property <bool> names: true;
    in property <bool> dots: true;
    in property <int> glass: 1; // 0 dense .. 2 clear
    in property <int> gravity: 1; // 0 none, 1 top-left, 2 top-right
    in property <bool> snap: true;
    in property <bool> ptitle: true; // folder name + dot in the header
    in property <bool> tnames: true; // folder name under desktop tiles
    in property <bool> autostart; // start with Windows (registry)
    in property <float> reveal: 1; // open / close animation: content fade (Rust drives it)
    in-out property <int> page: 0; // 0 = folder, 1 = settings

    in property <bool> pinned; // pinned open on the desktop (tile hidden)
    in property <int> isize: 1; // icon size 0..2 (settings page)
    in property <bool> en; // UI language: true = English, false = Russian
    callback toggle-pin();
    callback hover(int, length, length, length, length); // slot id (-1 = none) + its rect, window coords
    callback launch(int);
    callback item-menu(int); // right click on a shortcut (slot id)
    callback open-group(int); // "+N" / fold slot: unfold the group / fold it back
    callback pick-color(int, color);
    callback clear-color(int);
    callback close-panel();
    callback page-changed(int);
    callback set-opt(string, int); // settings page: key, value (bool = 0/1)
    callback drag-start();
    callback quit();
    // drag of a shortcut: id, point in grid coords, inside panel body (else = cancel)
    callback item-drag(int, length, length, bool);
    callback item-drop(int, length, length, bool);
    // drag of a group by its header (resize = false) or corner grip (resize = true): idx, point in grid coords
    callback group-drag(int, length, length, bool);
    callback group-drop(int, length, length, bool);
    callback drag-cancel();
    callback rename-group(string, string); // old name, typed name

    in-out property <int> drop-target: -2; // from Rust: group idx, -1 = new group (ghost), -2 = nothing
    in-out property <int> drop-index: 0; // from Rust: insert place in target group
    in-out property <int> rename-idx: -1; // group whose title is an edit field
    in property <bool> ghost-on; // from Rust: plate of the new group under the dragged item
    in property <length> ghost-x;
    in property <length> ghost-y;
    in property <length> ghost-w;
    in property <length> ghost-h;
    out property <int> drag-id: -1;
    property <int> drag-group: -1; // group the dragged item comes from
    property <int> drag-k: -1; // its index there
    out property <int> gdrag: -1; // group being moved / resized
    property <image> drag-icon;
    property <length> drag-x; // cursor, panel coords
    property <length> drag-y;
    // moved / resized group follows the cursor freely (grid px, from Rust); lands on the grid on release
    in-out property <length> lift-x;
    in-out property <length> lift-y;
    in-out property <length> lift-w;
    in-out property <length> lift-h;
    // landing: released shortcut glides from the cursor into its slot (Rust sets the target)
    in-out property <bool> land-on;
    in-out property <bool> land-go; // false while placed at the cursor (no glide), true = glide to target
    in-out property <int> land-id: -1; // slot hidden while its icon is in flight
    in-out property <image> land-icon;
    in-out property <length> land-x;
    in-out property <length> land-y;

    property <length> pad: 16px;
    property <length> top: 48px;
    // group header: title and/or dot -> 30px; none -> plate hugs its slots (main.rs App::head, model::set_header)
    property <length> head: names || dots ? 30px : 0px;
    property <int> pick-target: -1;
    property <length> pick-x;
    property <length> pick-y;
    // matte layer strength over system acrylic, by glass level
    property <float> matte: glass == 0 ? 0.40 : glass == 1 ? 0.16 : 0.0;
    property <color> fg: dark ? #ffffff : #1b1b1b;
    property <color> accent: dark ? #60cdff : #005fb8;
    // settings page needs room: panel grows while it is shown
    // folder page: hugs its groups, but the header keeps 3 buttons + a drag strip (buttons slide left with the edge)
    out property <length> min-w: page == 1 ? 372px : 168px;
    out property <length> settings-h: 846px;

    in property <bool> grow-anim; // window size glides (groups make room, unfold, settings); off while opening
    width: max(grid-w + 2 * pad, min-w);
    height: page == 1 ? max(grid-h + top + pad, settings-h) : grid-h + top + pad;
    animate width, height { duration: grow-anim ? 170ms : 0ms; easing: ease-out; }

    // below header, inside window
    pure function inside(x: length, y: length) -> bool {
        x >= 0 && x <= root.width && y >= top - 8px && y <= root.height
    }

    public function focus-keys() {
        fs.focus();
    }

    // dragged shortcut let go: its icon stays at the cursor until Rust says where to glide
    function start-landing(id: int) {
        land-go = false;
        land-x = drag-x;
        land-y = drag-y;
        land-icon = drag-icon;
        land-id = id;
        land-on = true;
    }

    // group starts moving / resizing: drawn from where it is now
    function lift-group(g: GroupData) {
        lift-x = g.x;
        lift-y = g.y;
        lift-w = g.w;
        lift-h = g.h;
        gdrag = g.idx;
    }

    function pick-for(idx: int, x: length, y: length) {
        pick-target = idx;
        pick-x = x;
        pick-y = y;
        cp.show();
    }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (page == 1) {
                    page = 0;
                    root.page-changed(0);
                } else if (!pinned) {
                    root.close-panel();
                }
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        background: (dark ? #202020 : #f3f3f3).with-alpha(matte);
        border-radius: 8px;
        border-width: 1px;
        border-color: dark ? #ffffff20 : #ffffff60;
    }

    // everything fades with the open / close animation
    body := Rectangle {
        opacity: reveal;

        // header = drag handle (buttons below are on top of it)
        TouchArea {
            x: 0;
            y: 0;
            width: parent.width - 138px;
            height: top - 6px;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.drag-start();
                }
            }
        }

        if page == 0 && ptitle: Dot {
            x: pad + 2px;
            y: 17px;
            c: folder-tint;
            empty: !folder-colored;
            dark: root.dark;
            clicked => { root.pick-for(-1, pad, 36px); }
        }
        if page == 1: CapButton {
            x: 0;
            y: 0;
            glyph: "\u{E72B}"; // back arrow
            glyph-size: 12px;
            dark: root.dark;
            border-top-left-radius: 8px;
            clicked => {
                page = 0;
                root.page-changed(0);
            }
        }
        Text {
            visible: page == 1 || ptitle;
            x: page == 0 ? pad + 26px : 50px;
            y: page == 0 ? 12px : 0px; // settings title: centered with back arrow / gear (36px buttons)
            height: page == 0 ? 24px : 36px;
            width: parent.width - self.x - 142px;
            opacity: self.width > 36px ? 1 : 0; // narrow window: dot only, no "..." stub
            text: page == 0 ? folder-name : (root.en ? "Settings" : "Настройки");
            font-size: page == 0 ? 16px : 14px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
            color: fg;
        }
        CapButton {
            x: parent.width - 138px;
            y: 0;
            glyph: "\u{E713}"; // settings gear
            glyph-size: 14px;
            dark: root.dark;
            clicked => {
                page = page == 1 ? 0 : 1;
                root.page-changed(page);
            }
        }
        // pin: folder stays open on the desktop, its tile hides; again = unpin
        CapButton {
            x: parent.width - 92px;
            y: 0;
            glyph: pinned ? "\u{E77A}" : "\u{E718}"; // unpin / pin
            glyph-color: pinned ? root.accent : root.fg;
            glyph-size: 14px;
            dark: root.dark;
            clicked => { root.toggle-pin(); }
        }
        CapButton {
            x: parent.width - 46px;
            y: 0;
            glyph: "\u{E8BB}"; // close X
            danger: true;
            dark: root.dark;
            border-top-right-radius: 8px;
            clicked => { root.close-panel(); }
        }

        // ---------- folder page ----------
        // page switch: one page fades out fast, the other comes in after it (no double-exposure mix)
        Rectangle {
            opacity: page == 0 ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: page == 0 ? 160ms : 90ms; delay: page == 0 ? 60ms : 0ms; easing: ease-out; }

            // plate of the new group, appears under the dragged item over empty space
            if ghost-on: Rectangle {
                x: pad + ghost-x;
                y: top + ghost-y;
                width: ghost-w;
                height: ghost-h;
                border-radius: 8px;
                background: accent.with-alpha(0.16);
                border-width: 2px;
                border-color: accent;
                animate x, y { duration: 140ms; easing: ease-out; }
                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 16px;
                    text: (root.en ? "New group" : "Новая группа");
                    font-size: 11px;
                    font-weight: 600;
                    overflow: elide;
                    color: dark ? #ffffffc0 : #1b1b1bc0;
                }
            }

            for g in groups: gr := Rectangle {
                property <bool> hot: root.drop-target == g.idx; // dragged item will land here
                property <bool> src: root.drag-id >= 0 && root.drag-group == g.idx; // dragged item comes from here
                property <int> n-eff: g.n - (src && !hot ? 1 : 0) + (hot && !src ? 1 : 0);
                property <int> cap: g.cols * g.rows;
                property <bool> lifting: root.gdrag == g.idx;
                x: pad + (lifting ? root.lift-x : g.x);
                y: top + (lifting ? root.lift-y : g.y);
                width: lifting ? root.lift-w : g.w;
                height: lifting ? root.lift-h : g.h;
                // under the cursor: no lag; else (others making room, landing after release): glide
                animate x, y, width, height { duration: lifting ? 0ms : 170ms; easing: ease-out; }
                border-radius: 8px;
                background: hot ? accent.with-alpha(0.2) : g.colored ? g.tint.with-alpha(dark ? 0.16 : 0.14) : (dark ? #ffffff0c : #ffffff38);
                border-width: hot || lifting ? 2px : 1px;
                border-color: hot || lifting ? accent : g.colored ? g.tint.with-alpha(0.32) : (dark ? #ffffff1c : #ffffff70);
                animate background, border-color { duration: 120ms; }
                drop-shadow-blur: lifting ? 14px : 0px;
                drop-shadow-color: #00000040;

                // hover (shows resize grip); right click anywhere on the plate = color
                hov := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.pick-for(g.idx, pad + g.x + self.mouse-x, top + g.y + self.mouse-y);
                        }
                    }
                }

                Dot {
                    visible: root.dots;
                    x: 7px;
                    y: 8px;
                    c: g.tint;
                    empty: !g.colored;
                    dark: root.dark;
                    clicked => { root.pick-for(g.idx, pad + g.x + 4px, top + g.y + 26px); }
                }
                Text {
                    visible: root.names && root.rename-idx != g.idx;
                    x: root.dots ? 26px : 10px;
                    y: 5px;
                    height: 20px;
                    width: parent.width - self.x - 4px;
                    text: g.fixed ? (root.en ? "Misc" : "Разное") : g.name;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    color: dark ? #ffffffe8 : #1b1b1be8;
                }
                // header: drag = move group, double-click title = rename, right click = color
                TouchArea {
                    x: root.dots ? 26px : 0px;
                    y: 0;
                    width: parent.width - self.x - 4px;
                    height: root.head;
                    enabled: root.rename-idx != g.idx;
                    property <bool> moving;
                    double-clicked => {
                        if (!g.fixed && root.names) {
                            root.rename-idx = g.idx;
                        }
                    }
                    moved => {
                        if (!moving && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px)) {
                            moving = true;
                            root.lift-group(g);
                        }
                        if (moving) {
                            root.group-drag(g.idx, gr.x + self.x + self.mouse-x - pad, gr.y + self.y + self.mouse-y - top, false);
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.pick-for(g.idx, pad + g.x + self.x + self.mouse-x, top + g.y + self.mouse-y);
                        } else if (moving && e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                            moving = false;
                            root.gdrag = -1;
                            root.group-drop(g.idx, gr.x + self.x + self.mouse-x - pad, gr.y + self.y + self.mouse-y - top, false);
                        } else if (moving && e.kind == PointerEventKind.cancel) {
                            moving = false;
                            root.gdrag = -1;
                            root.drag-cancel();
                        }
                    }
                }
                // inline rename: Enter = rename folder, Esc / focus loss = keep name
                if root.rename-idx == g.idx: Rectangle {
                    x: root.dots ? 22px : 6px;
                    y: 5px;
                    height: 20px;
                    width: parent.width - self.x - 4px;
                    border-radius: 4px;
                    background: dark ? #00000060 : #ffffffc0;
                    border-width: 1px;
                    border-color: accent;
                    clip: true;
                    TextInput {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        text: g.name;
                        single-line: true;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: fg;
                        selection-background-color: #0078d480;
                        init => {
                            self.focus();
                            self.select-all();
                        }
                        accepted => { root.rename-group(g.name, self.text); }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.rename-idx = -1;
                                fs.focus();
                                return accept;
                            }
                            return reject;
                        }
                        changed has-focus => {
                            if (!self.has-focus && root.rename-idx == g.idx) {
                                root.rename-idx = -1;
                            }
                        }
                    }
                }
                for s in g.items: Slot {
                    property <bool> me: root.drag-id == s.id;
                    // place after the dragged item left (same group: later ones step back) ...
                    property <int> e0: s.k - (src && s.k > root.drag-k ? 1 : 0);
                    // ... and made room for it at drop-index (target group)
                    property <int> e: me ? (hot ? root.drop-index : s.k) : e0 + (hot && e0 >= root.drop-index ? 1 : 0);
                    x: mod(e, g.cols) * 84px;
                    y: root.head + floor(e / g.cols) * 84px;
                    animate x, y { duration: 160ms; easing: ease-out; }
                    visible: e < cap;
                    more: !me && n-eff > cap && e == cap - 1 ? n-eff - cap + 1 : 0;
                    d: s;
                    labels: root.labels;
                    en: root.en;
                    dark: root.dark;
                    lifted: me ? (hot ? 0.3 : 0) : root.land-on && root.land-id == s.id ? 0 : 1;
                    hover(on) => { root.hover(on ? s.id : -1, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                    menu => { root.item-menu(s.id); }
                    clicked => {
                        if (self.more > 0) {
                            root.open-group(g.idx); // unfold in place
                        } else {
                            root.launch(s.id);
                        }
                    }
                    drag-move(mx, my) => {
                        if (root.drag-id != s.id) {
                            root.drag-group = g.idx;
                            root.drag-k = s.k;
                        }
                        root.drag-id = s.id;
                        root.drag-icon = s.icon;
                        root.drag-x = gr.x + self.x + mx;
                        root.drag-y = gr.y + self.y + my;
                        root.item-drag(s.id, root.drag-x - pad, root.drag-y - top, root.inside(root.drag-x, root.drag-y));
                    }
                    drag-end(mx, my) => {
                        root.drag-x = gr.x + self.x + mx;
                        root.drag-y = gr.y + self.y + my;
                        root.start-landing(s.id);
                        root.item-drop(s.id, root.drag-x - pad, root.drag-y - top, root.inside(root.drag-x, root.drag-y));
                        root.drag-id = -1;
                        root.drag-group = -1;
                    }
                    drag-cancel => {
                        root.start-landing(s.id);
                        root.drag-id = -1;
                        root.drag-group = -1;
                        root.drag-cancel();
                    }
                }
                // unfolded group: last slot folds it back
                if g.open: Slot {
                    property <int> e: n-eff;
                    x: mod(e, g.cols) * 84px;
                    y: root.head + floor(e / g.cols) * 84px;
                    animate x, y { duration: 160ms; easing: ease-out; }
                    d: { name: "", id: -1, k: -1 };
                    more: -1;
                    labels: root.labels;
                    en: root.en;
                    dark: root.dark;
                    clicked => { root.open-group(g.idx); }
                }
                // plate edges = drag handles too (the only ones when there is no header)
                Grip {
                    x: 0; y: 0; width: 6px; height: parent.height;
                    enabled: root.drag-id < 0;
                    lifted => { root.lift-group(g); }
                    go(px, py) => { root.group-drag(g.idx, gr.x + px - pad, gr.y + py - top, false); }
                    done(px, py) => {
                        root.gdrag = -1;
                        root.group-drop(g.idx, gr.x + px - pad, gr.y + py - top, false);
                    }
                    cancel => {
                        root.gdrag = -1;
                        root.drag-cancel();
                    }
                }
                Grip {
                    x: parent.width - 6px; y: 0; width: 6px; height: parent.height;
                    enabled: root.drag-id < 0;
                    lifted => { root.lift-group(g); }
                    go(px, py) => { root.group-drag(g.idx, gr.x + px - pad, gr.y + py - top, false); }
                    done(px, py) => {
                        root.gdrag = -1;
                        root.group-drop(g.idx, gr.x + px - pad, gr.y + py - top, false);
                    }
                    cancel => {
                        root.gdrag = -1;
                        root.drag-cancel();
                    }
                }
                Grip {
                    x: 0; y: parent.height - 6px; width: parent.width; height: 6px;
                    enabled: root.drag-id < 0;
                    lifted => { root.lift-group(g); }
                    go(px, py) => { root.group-drag(g.idx, gr.x + px - pad, gr.y + py - top, false); }
                    done(px, py) => {
                        root.gdrag = -1;
                        root.group-drop(g.idx, gr.x + px - pad, gr.y + py - top, false);
                    }
                    cancel => {
                        root.gdrag = -1;
                        root.drag-cancel();
                    }
                }
                if root.head == 0: Grip {
                    x: 0; y: 0; width: parent.width; height: 6px;
                    enabled: root.drag-id < 0;
                    lifted => { root.lift-group(g); }
                    go(px, py) => { root.group-drag(g.idx, gr.x + px - pad, gr.y + py - top, false); }
                    done(px, py) => {
                        root.gdrag = -1;
                        root.group-drop(g.idx, gr.x + px - pad, gr.y + py - top, false);
                    }
                    cancel => {
                        root.gdrag = -1;
                        root.drag-cancel();
                    }
                }
                // resize grip (bottom-right): drag = change size in whole slots
                TouchArea {
                    x: parent.width - 18px;
                    y: parent.height - 18px;
                    width: 18px;
                    height: 18px;
                    property <bool> sizing;
                    moved => {
                        if (self.pressed) {
                            sizing = true;
                            root.lift-group(g);
                            root.group-drag(g.idx, gr.x + self.x + self.mouse-x - pad, gr.y + self.y + self.mouse-y - top, true);
                        }
                    }
                    pointer-event(e) => {
                        if (sizing && e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                            sizing = false;
                            root.gdrag = -1;
                            root.group-drop(g.idx, gr.x + self.x + self.mouse-x - pad, gr.y + self.y + self.mouse-y - top, true);
                        } else if (sizing && e.kind == PointerEventKind.cancel) {
                            sizing = false;
                            root.gdrag = -1;
                            root.drag-cancel();
                        }
                    }
                    // corner mark, on hover
                    if hov.has-hover || self.has-hover || lifting: Path {
                        x: 5px;
                        y: 5px;
                        width: 8px;
                        height: 8px;
                        viewbox-width: 8;
                        viewbox-height: 8;
                        commands: "M 8 0 L 8 8 L 0 8";
                        stroke: dark ? #ffffff90 : #00000070;
                        stroke-width: 1.5px;
                    }
                }
            }

            // released icon gliding into its slot
            if land-on: Image {
                source: land-icon;
                x: land-x - 24px;
                y: land-y - 24px;
                width: 48px;
                height: 48px;
                animate x, y { duration: land-go ? 180ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
            }
            // ghost of dragged icon follows cursor
            if drag-id >= 0: Image {
                source: drag-icon;
                x: drag-x - 24px;
                y: drag-y - 24px;
                width: 48px;
                height: 48px;
                opacity: 0.85;
            }
        }

        // ---------- settings page ----------
        // two blocks: the folder itself (window header + desktop tile) and the groups inside it
        if page == 1: Rectangle {
            property <length> cw: parent.width - 2 * pad; // card width
            opacity: 0;
            y: 10px;
            init => {
                self.opacity = 1;
                self.y = 0;
            }
            animate opacity { duration: 180ms; delay: 70ms; easing: ease-out; }
            animate y { duration: 240ms; delay: 70ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }

            SectionTitle {
                x: pad + 2px;
                y: top;
                text: (root.en ? "Folder" : "Папка");
                dark: root.dark;
            }
            Card {
                x: pad;
                y: top + 24px;
                width: cw;
                height: 4 * 44px;
                dark: root.dark;
                SwitchRow {
                    y: 0;
                    height: 44px;
                    label: (root.en ? "Folder window title" : "Название окна папки");
                    on: root.ptitle;
                    dark: root.dark;
                    accent: root.accent;
                    toggled => { root.set-opt("ptitle", root.ptitle ? 0 : 1); }
                }
                SwitchRow {
                    y: 44px;
                    height: 44px;
                    line: true;
                    label: (root.en ? "Name on desktop" : "Название на рабочем столе");
                    on: root.tnames;
                    dark: root.dark;
                    accent: root.accent;
                    toggled => { root.set-opt("tnames", root.tnames ? 0 : 1); }
                }
                SwitchRow {
                    y: 88px;
                    height: 44px;
                    line: true;
                    label: (root.en ? "Snap to grid" : "Привязка к сетке");
                    on: root.snap;
                    dark: root.dark;
                    accent: root.accent;
                    toggled => { root.set-opt("snap", root.snap ? 0 : 1); }
                }
                SwitchRow {
                    y: 132px;
                    height: 44px;
                    line: true;
                    label: (root.en ? "Start with Windows" : "Запуск с Windows");
                    on: root.autostart;
                    dark: root.dark;
                    accent: root.accent;
                    toggled => { root.set-opt("autostart", root.autostart ? 0 : 1); }
                }
            }

            SectionTitle {
                x: pad + 2px;
                y: top + 216px;
                text: (root.en ? "Folder subgroups" : "Подгруппы папки");
                dark: root.dark;
            }
            Card {
                x: pad;
                y: top + 240px;
                width: cw;
                height: 3 * 44px + 84px;
                dark: root.dark;
                SwitchRow {
                    y: 0;
                    height: 44px;
                    label: (root.en ? "Subgroup names" : "Названия подгрупп");
                    on: root.names;
                    dark: root.dark;
                    accent: root.accent;
                    toggled => { root.set-opt("names", root.names ? 0 : 1); }
                }
                SwitchRow {
                    y: 44px;
                    height: 44px;
                    line: true;
                    label: (root.en ? "Color tags" : "Цветовые метки");
                    on: root.dots;
                    dark: root.dark;
                    accent: root.accent;
                    toggled => { root.set-opt("dots", root.dots ? 0 : 1); }
                }
                SwitchRow {
                    y: 88px;
                    height: 44px;
                    line: true;
                    label: (root.en ? "Shortcut labels" : "Подписи под ярлыками");
                    on: root.labels;
                    dark: root.dark;
                    accent: root.accent;
                    toggled => { root.set-opt("labels", root.labels ? 0 : 1); }
                }
                Hairline {
                    y: 132px;
                    x: 14px;
                    width: parent.width - 28px;
                    dark: root.dark;
                }
                // label on its own line, choice under it: fits the narrowest panel
                RowText {
                    y: 132px;
                    height: 40px;
                    label: (root.en ? "Pull groups to corner" : "Притяжение групп к углу");
                    dark: root.dark;
                }
                Seg {
                    x: 12px;
                    y: 132px + 40px;
                    seg-w: (parent.width - 28px) / 3;
                    items: root.en ? ["None", "Left", "Right"] : ["Нет", "Влево", "Вправо"];
                    sel: root.gravity;
                    dark: root.dark;
                    pick(i) => { root.set-opt("gravity", i); }
                }
            }

            SectionTitle {
                x: pad + 2px;
                y: top + 472px;
                text: (root.en ? "Glass" : "Стекло");
                dark: root.dark;
            }
            Card {
                x: pad;
                y: top + 496px;
                width: cw;
                height: 52px;
                dark: root.dark;
                Seg {
                    x: 12px;
                    y: 12px;
                    seg-w: (parent.width - 28px) / 3;
                    items: root.en ? ["Dense", "Medium", "Clear"] : ["Плотное", "Среднее", "Прозрачное"];
                    sel: root.glass;
                    dark: root.dark;
                    pick(i) => { root.set-opt("glass", i); }
                }
            }

            // icon size = zoom of folder windows and desktop tiles (model::ZOOM)
            SectionTitle {
                x: pad + 2px;
                y: top + 564px;
                text: (root.en ? "Icon size" : "Размер иконок");
                dark: root.dark;
            }
            Card {
                x: pad;
                y: top + 588px;
                width: cw;
                height: 52px;
                dark: root.dark;
                Seg {
                    x: 12px;
                    y: 12px;
                    seg-w: (parent.width - 28px) / 3;
                    items: root.en ? ["Small", "Medium", "Large"] : ["Мелкие", "Средние", "Крупные"];
                    sel: root.isize;
                    dark: root.dark;
                    pick(i) => { root.set-opt("isize", i); }
                }
            }

            // UI language (labels stay bilingual-neutral: each in its own language)
            SectionTitle {
                x: pad + 2px;
                y: top + 656px;
                text: (root.en ? "Language" : "Язык");
                dark: root.dark;
            }
            Card {
                x: pad;
                y: top + 680px;
                width: cw;
                height: 52px;
                dark: root.dark;
                Seg {
                    x: 12px;
                    y: 12px;
                    seg-w: (parent.width - 28px) / 2;
                    items: ["Русский", "English"];
                    sel: root.en ? 1 : 0;
                    dark: root.dark;
                    pick(i) => { root.set-opt("lang", i); }
                }
            }

            // quit: quiet text button, red only on hover
            qb := Rectangle {
                x: pad;
                y: top + 748px;
                width: 180px;
                height: 34px;
                border-radius: 6px;
                background: qt.has-hover ? #c42b1c1f : transparent;
                Text {
                    x: 12px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: "\u{E7E8}";
                    font-family: "Segoe Fluent Icons";
                    font-size: 13px;
                    color: qt.has-hover ? (dark ? #ff99a4 : #c42b1c) : (dark ? #ffffffb0 : #1b1b1bb0);
                }
                Text {
                    x: 36px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: (root.en ? "Quit app" : "Закрыть программу");
                    font-size: 13px;
                    color: qt.has-hover ? (dark ? #ff99a4 : #c42b1c) : (dark ? #ffffffb0 : #1b1b1bb0);
                }
                qt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.quit(); }
                }
            }
        }
    }

    // color picker: first = no color, then palette
    cp := PopupWindow {
        x: min(pick-x, root.width - 184px);
        y: pick-y;
        width: 176px;
        height: 64px;
        Rectangle {
            background: dark ? #2c2c2c : #fbfbfb;
            border-radius: 8px;
            border-width: 1px;
            border-color: #80808040;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            Dot {
                x: 8px;
                y: 8px;
                size: 22px;
                empty: true;
                dark: root.dark;
                Rectangle { // slash = "no color"
                    x: 10px;
                    y: 3px;
                    width: 2px;
                    height: 16px;
                    background: dark ? #ffffffa0 : #000000a0;
                }
                clicked => {
                    root.clear-color(root.pick-target);
                    cp.close();
                }
            }
            for c[i] in pal: Dot {
                x: 8px + mod(i + 1, 6) * 28px;
                y: 8px + floor((i + 1) / 6) * 28px;
                size: 22px;
                c: c;
                dark: root.dark;
                clicked => {
                    root.pick-color(root.pick-target, c);
                    cp.close();
                }
            }
        }
    }
}

export component Tile inherits Window {
    no-frame: true;
    background: transparent;
    title: "Glass Folder";

    in property <string> name;
    in property <color> tint;
    in property <bool> colored;
    in property <[image]> icons; // most launched first
    in property <int> total; // all items in the folder (icons holds at most 24)
    in property <bool> dark; // set from Rust (Windows app theme)
    in property <image> backdrop; // fallback only (GF_FAKE_GLASS): frosted wallpaper copy
    in property <int> glass: 1; // 0 dense .. 2 clear, same as Panel
    in property <bool> named: true; // name strip under icons; off = square cells, even edges
    in property <bool> drop-hot; // a shortcut dragged out of a folder window is over this tile
    callback open();
    callback launch(int); // icon index -> run that file
    callback item-menu(int); // right click on an icon: shortcut menu
    callback hover(int, length, length, length, length); // icon index (-1 = none) + its rect: name hint

    // size comes from Rust, snapped to whole cells (plat.rs tile_size: w = cols*48+12, h = rows*42+30 or rows*48+12)
    // floor: while a resize is dragged the size is free -> only whole cells that fit are shown
    property <length> cell-h: named ? 42px : 48px;
    property <length> pad-top: named ? 8px : 12px;
    property <int> cols: max(2, floor((root.width - 12px + 1px) / 48px));
    property <int> rows: max(2, floor((root.height - (named ? 30px : 12px) + 1px) / cell-h));
    property <length> grid-x: (root.width - cols * 48px + 12px) / 2;

    Image {
        source: backdrop;
        width: parent.width;
        height: parent.height;
        image-fit: fill;
    }
    // matte layer over system acrylic (as Panel)
    Rectangle {
        border-radius: 8px;
        background: (dark ? #202020 : #f3f3f3).with-alpha(glass == 0 ? 0.40 : glass == 1 ? 0.16 : 0.0);
    }
    Rectangle {
        background: drop-hot ? (dark ? #ffffff2c : #ffffff70) : colored ? tint.with-alpha(ta.has-hover ? 0.22 : 0.12) : (ta.has-hover ? (dark ? #ffffff14 : #ffffff40) : transparent);
        animate background, border-color { duration: 150ms; }
        border-radius: 8px;
        border-width: drop-hot ? 2px : 1px;
        border-color: drop-hot ? (dark ? #60cdff : #005fb8) : colored ? tint.with-alpha(0.7) : (dark ? #ffffff30 : #ffffff90);
    }
    if named: Text {
        x: 8px;
        y: parent.height - 21px;
        width: parent.width - 16px;
        height: 16px;
        text: name;
        font-size: 11px;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: center;
        color: dark ? #ffffff : #1b1b1b;
    }
    // cells: icon click = launch; empty space / name / "more" cell = open folder
    property <int> cap: cols * rows;
    property <bool> over: total > cap; // last cell becomes "+N" -> panel
    ta := TouchArea {
        clicked => { root.open(); }
        for ic[i] in icons: Rectangle {
            visible: over ? i < cap - 1 : i < cap;
            x: grid-x + mod(i, cols) * 48px - 4px;
            y: pad-top + floor(i / cols) * cell-h - 3px;
            width: 44px;
            height: 42px;
            border-radius: 6px;
            background: it.pressed ? (dark ? #ffffff30 : #00000020) : it.has-hover ? (dark ? #ffffff1c : #ffffff70) : transparent;
            animate background { duration: 100ms; }
            Image {
                x: 4px;
                y: 3px;
                source: ic;
                width: 36px;
                height: 36px;
            }
            it := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.launch(i); }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                        root.item-menu(i);
                    }
                }
            }
            property <bool> hovered: it.has-hover && !it.pressed;
            changed hovered => { root.hover(hovered ? i : -1, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
        }
        // "+N": part of the tile itself (no hover of its own): hover lights the whole tile, drag moves it.
        // Soft squircle behind it = reads as a cell, like the panel's "+N" slot.
        if over: Rectangle {
            x: grid-x + mod(cap - 1, cols) * 48px + 2px;
            y: pad-top + floor((cap - 1) / cols) * cell-h + 2px;
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: dark ? #ffffff14 : #0000000d;
        }
        if over: Text {
            x: grid-x + mod(cap - 1, cols) * 48px - 4px;
            y: pad-top + floor((cap - 1) / cols) * cell-h - 3px;
            width: 44px;
            height: 42px;
            text: "+" + (total - cap + 1);
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: dark ? #ffffffc0 : #1b1b1bc0;
        }
    }
    // resize grip hint (bottom-right, see plat::GRIP)
    if ta.has-hover: Rectangle {
        x: parent.width - 10px;
        y: parent.height - 10px;
        width: 5px;
        height: 5px;
        border-radius: 1px;
        background: dark ? #ffffff70 : #00000050;
    }
}

// Name hint: small glass label under a hovered shortcut (own topmost window, clicks go through).
export component Hint inherits Window {
    no-frame: true;
    background: transparent;
    title: "Glass Folders hint";
    in property <string> text;
    in property <bool> dark;
    out property <length> pw: min(t.preferred-width, 320px) + 20px; // Rust sizes the window from it
    Rectangle {
        border-radius: 6px;
        background: (dark ? #2c2c2c : #f9f9f9).with-alpha(0.97); // own window, no glass behind it
        border-width: 1px;
        border-color: dark ? #ffffff24 : #00000018;
    }
    t := Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: center;
        color: dark ? #ffffff : #1b1b1b;
    }
}

// Rename box: small glass field at the shortcut. Enter = rename, Esc / click away = cancel (Rust).
export component Ask inherits Window {
    no-frame: true;
    background: transparent;
    title: "Glass Folders rename";
    in property <bool> dark;
    in-out property <string> text;
    callback done(bool, string); // ok, typed text
    width: 280px;
    height: 44px;
    public function start() {
        ed.focus();
        ed.select-all();
    }
    Rectangle {
        border-radius: 8px;
        background: (dark ? #2c2c2c : #f9f9f9).with-alpha(0.98);
        border-width: 1px;
        border-color: dark ? #ffffff30 : #00000020;
    }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.done(false, "");
                return accept;
            }
            return reject;
        }
        ed := TextInput {
            x: 12px;
            y: 0;
            width: parent.width - 24px;
            height: parent.height;
            text <=> root.text;
            font-size: 13px;
            vertical-alignment: center;
            single-line: true;
            color: dark ? #ffffff : #1b1b1b;
            selection-background-color: dark ? #60cdff80 : #005fb860;
            accepted => { root.done(true, self.text); }
        }
    }
}

// Shortcut dragged out of a folder window: its icon follows the cursor (own topmost click-through window).
export component Fly inherits Window {
    no-frame: true;
    background: transparent;
    title: "Glass Folders drag";
    in property <image> pic;
    in property <float> fade: 1;
    Image {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        source: pic;
        opacity: 0.9 * fade;
    }
}
